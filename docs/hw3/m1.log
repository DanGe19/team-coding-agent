 });\n    if (btnRestartOver) btnRestartOver.addEventListener('click', () => {\n      started = true;\n      window.__tetris.reset();\n      if (btnStart) btnStart.disabled = true;\n      const pauseBtn = document.getElementById('btn-pause');\n      if (pauseBtn) pauseBtn.textContent = 'Pause';\n    });\n\n    // Keyboard\n    document.addEventListener('keydown', onKey);\n\n    // Hook into gravity ticks for re-render\n    window.__tetris._onTick = render;\n\n    // Initial render\n    render();\n    requestAnimationFrame(loop);\n  }\n\n  function loop() {\n    render();\n    requestAnimationFrame(loop);\n  }\n\n  function onKey(e) {\n    const t = window.__tetris;\n    const state = t.getState();\n    if (state.gameOver) {\n      if (e.key === 'r' || e.key === 'R') t.reset();\n      return;\n    }\n    switch (e.key) {\n      case 'ArrowUp':    e.preventDefault(); t.shift(-1); break;\n      case 'ArrowDown':  e.preventDefault(); t.shift(1);  break;\n      case 'ArrowRight':\n        e.preventDefault();\n        if (state.active && state.active.side === 'left') t.softDrop();\n        break;\n      case 'ArrowLeft':\n        e.preventDefault();\n        if (state.active && state.active.side === 'right') t.softDrop();\n        break;\n      case 'z': case 'Z': t.rotate(-1); break;\n      case 'x': case 'X': t.rotate(1);  break;\n      case ' ':  e.preventDefault(); t.hardDrop(); break;\n      case 'p': case 'P': t.togglePause(); break;\n      case 'r': case 'R': t.reset(); break;\n    }\n  }\n\n  function getGhostCol(active) {\n    if (!active) return null;\n    const t = window.__tetris;\n    const dc = active.side === 'left' ? 1 : -1;\n    let col = active.col;\n    while (true) {\n      const nc = col + dc;\n      if (t._isValidPosition(active.type, active.rotState, active.row, nc, active.side)) {\n        col = nc;\n      } else break;\n    }\n    return col;\n  }\n\n  function render() {\n    if (!ctx) return;\n    const t = window.__tetris;\n    const state = t.getState();\n    const settled = t._getSettled();\n    const active = t._getActive();\n\n    // Background\n    ctx.fillStyle = BG_COLOR;\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n    // Draw grid\n    ctx.strokeStyle = GRID_COLOR;\n    ctx.lineWidth = 0.5;\n    for (let r = 0; r <= ROWS; r++) {\n      ctx.beginPath();\n      ctx.moveTo(0, r * CELL);\n      ctx.lineTo(canvas.width, r * CELL);\n      ctx.stroke();\n    }\n    for (let c = 0; c <= COLS; c++) {\n      ctx.beginPath();\n      ctx.moveTo(c * CELL, 0);\n      ctx.lineTo(c * CELL, canvas.height);\n      ctx.stroke();\n    }\n\n    // Draw settled cells\n    for (let r = 0; r < ROWS; r++) {\n      for (let c = 0; c < COLS; c++) {\n        if (settled[r][c]) {\n          drawCell(c, r, SETTLED_COLORS[settled[r][c]], 1);\n        }\n      }\n    }\n\n    // Draw ghost\n    if (active && !state.paused) {\n      const ghostCol = getGhostCol(active);\n      if (ghostCol !== active.col) {\n        const ghostCells = t._getCells(active.type, active.rotState, active.row, ghostCol);\n        for (const [gr, gc] of ghostCells) {\n          drawCell(gc, gr, GHOST_COLOR, 0);\n        }\n      }\n    }\n\n    // Draw active piece\n    if (active) {\n      const cells = t._getCells(active.type, active.rotState, active.row, active.col);\n      for (const [r, c] of cells) {\n        drawCell(c, r, COLORS[active.type], 1);\n      }\n    }\n\n    // Draw center wall\n    const wallX = WALL_RIGHT * CELL;\n    ctx.fillStyle = WALL_COLOR;\n    ctx.fillRect(wallX - 3, 0, 6, canvas.height);\n\n    // Dim overlay if paused\n    if (state.paused) {\n      ctx.fillStyle = 'rgba(0,0,0,0.35)';\n      ctx.fillRect(0, 0, canvas.width, canvas.height);\n      ctx.fillStyle = '#FFF8F0';\n      ctx.font = 'bold 32px Nunito, Quicksand, sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('PAUSED', canvas.width / 2, canvas.height / 2);\n    }\n\n    // Game over overlay\n    const gameOverEl = document.getElementById('game-over');\n    if (gameOverEl) {\n      gameOverEl.style.display = state.gameOver ? 'flex' : 'none';\n    }\n\n    // Update score display\n    const scoreEl = document.getElementById('score-val');\n    const linesEl = document.getElementById('lines-val');\n    const levelEl = document.getElementById('level-val');\n    if (scoreEl) scoreEl.textContent = state.score;\n    if (linesEl) linesEl.textContent = state.lines;\n    if (levelEl) levelEl.textContent = state.level;\n\n    // Draw next piece preview\n    drawNextPreview(state.next, state.nextSide);\n  }\n\n  function drawCell(col, row, color, border) {\n    const x = col * CELL;\n    const y = row * CELL;\n    ctx.fillStyle = color;\n    ctx.fillRect(x + 1, y + 1, CELL - 2, CELL - 2);\n    if (border) {\n      ctx.strokeStyle = 'rgba(0,0,0,0.1)';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(x + 1, y + 1, CELL - 2, CELL - 2);\n    }\n  }\n\n  function drawNextPreview(nextType, nextSide) {\n    const previewCanvas = document.getElementById('preview-canvas');\n    if (!previewCanvas) return;\n    const pc = previewCanvas.getContext('2d');\n    const t = window.__tetris;\n    const shapes = t._SHAPES;\n    const cells = shapes[nextType] ? shapes[nextType][0] : [];\n\n    pc.fillStyle = BG_COLOR;\n    pc.fillRect(0, 0, previewCanvas.width, previewCanvas.height);\n\n    const pCell = 24;\n    const offsetX = 10;\n    const offsetY = 10;\n    for (const [r, c] of cells) {\n      pc.fillStyle = COLORS[nextType] || '#ccc';\n      pc.fillRect(offsetX + c * pCell + 1, offsetY + r * pCell + 1, pCell - 2, pCell - 2);\n      pc.strokeStyle = 'rgba(0,0,0,0.1)';\n      pc.lineWidth = 1;\n      pc.strokeRect(offsetX + c * pCell + 1, offsetY + r * pCell + 1, pCell - 2, pCell - 2);\n    }\n\n    // Arrow showing side\n    const arrowEl = document.getElementById('next-side-arrow');\n    if (arrowEl) {\n      arrowEl.textContent = nextSide === 'left' ? '\u2190 Left side' : 'Right side \u2192';\n    }\n  }\n\n  // Wait for DOM\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n\n})();\n"
}
