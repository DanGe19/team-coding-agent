ont-weight: 600;\n  color: #C4A8F0;\n  margin-top: 6px;\n  text-align: center;\n}\n\n.stats {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.stat-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.9rem;\n}\n\n.stat-label {\n  font-weight: 600;\n  color: #9A8A8A;\n}\n\n.stat-value {\n  font-weight: 800;\n  color: #5A4A4A;\n  font-size: 1rem;\n}\n\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\nbutton {\n  font-family: 'Nunito', 'Quicksand', sans-serif;\n  font-weight: 700;\n  font-size: 0.95rem;\n  padding: 10px 16px;\n  border: none;\n  border-radius: 10px;\n  cursor: pointer;\n  transition: background 0.15s, transform 0.1s;\n}\n\nbutton:active {\n  transform: scale(0.97);\n}\n\n#btn-start {\n  background: #B5EAD7;\n  color: #3A6A5A;\n}\n#btn-start:hover { background: #8DDFC4; }\n#btn-start:disabled { opacity: 0.5; cursor: default; }\n\n#btn-pause {\n  background: #E2D5F8;\n  color: #5A3A8A;\n}\n#btn-pause:hover { background: #C9B6F2; }\n\n#btn-restart, #btn-restart-over {\n  background: #FFD6E0;\n  color: #8A3A5A;\n}\n#btn-restart:hover, #btn-restart-over:hover { background: #F0A0B8; }\n\n.controls-hint {\n  font-size: 0.72rem;\n  color: #B0A0A0;\n  line-height: 1.6;\n}\n\n.controls-hint strong {\n  color: #9A8A8A;\n}\n"}}</tool_call>
