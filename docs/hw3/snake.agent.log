9B6F2;\n  border-radius: 8px;\n  font-family: inherit;\n  font-size: 0.95rem;\n  background: #FFF8F0;\n  color: #5A4A4A;\n  outline: none;\n  transition: border-color 0.2s;\n}\n\n#score-form input[name=\"name\"]:focus {\n  border-color: #7B5EA7;\n}\n\n#score-form button[type=\"submit\"] {\n  padding: 8px 16px;\n  background: #C9B6F2;\n  color: #5A4A4A;\n  border: none;\n  border-radius: 8px;\n  font-family: inherit;\n  font-size: 0.95rem;\n  font-weight: 700;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n#score-form button[type=\"submit\"]:hover {\n  background: #B5A0E8;\n}\n\n#score-form button[type=\"submit\"]:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.form-error {\n  color: #C0607A;\n  font-size: 0.85rem;\n  min-height: 1em;\n}\n\n.saved-msg {\n  color: #5A9A7A;\n  font-weight: 700;\n  font-size: 0.95rem;\n}\n\n/* Side panel */\n.side-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  min-width: 200px;\n  max-width: 240px;\n  flex: 1;\n}\n\n/* Stats */\n.stats-panel {\n  background: #FFF0F5;\n  border-radius: 12px;\n  padding: 16px;\n  box-shadow: 0 2px 8px rgba(90, 74, 74, 0.08);\n}\n\n.stat-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 4px 0;\n  border-bottom: 1px solid rgba(90, 74, 74, 0.08);\n}\n\n.stat-row:last-child {\n  border-bottom: none;\n}\n\n.stat-label {\n  font-weight: 600;\n  color: #8A7A7A;\n  font-size: 0.9rem;\n}\n\n.stat-value {\n  font-weight: 800;\n  font-size: 1.1rem;\n  color: #5A4A4A;\n}\n\n/* Buttons */\n.buttons-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.btn {\n  padding: 10px 16px;\n  border: none;\n  border-radius: 10px;\n  font-family: inherit;\n  font-size: 0.95rem;\n  font-weight: 700;\n  cursor: pointer;\n  transition: background 0.2s, transform 0.1s;\n}\n\n.btn:active {\n  transform: scale(0.97);\n}\n\n.btn-primary {\n  background: #B5EAD7;\n  color: #3A6A5A;\n}\n\n.btn-primary:hover {\n  background: #9ADBC5;\n}\n\n.btn-secondary {\n  background: #E8DEFF;\n  color: #5A4A7A;\n}\n\n.btn-secondary:hover {\n  background: #D5CCFF;\n}\n\n/* Controls hint */\n.controls-hint {\n  background: #FFF8F0;\n  border: 1px solid rgba(90, 74, 74, 0.1);\n  border-radius: 10px;\n  padding: 12px;\n  font-size: 0.82rem;\n  color: #8A7A7A;\n  line-height: 1.6;\n}\n\n.controls-hint p:first-child {\n  color: #5A4A4A;\n  margin-bottom: 4px;\n}\n\n/* Leaderboard */\n.leaderboard-panel {\n  background: #FFF0F5;\n  border-radius: 12px;\n  padding: 16px;\n  box-shadow: 0 2px 8px rgba(90, 74, 74, 0.08);\n}\n\n.leaderboard-panel h3 {\n  font-size: 1rem;\n  font-weight: 800;\n  color: #7B5EA7;\n  margin-bottom: 10px;\n  text-align: center;\n}\n\n#leaderboard {\n  list-style: decimal inside;\n  padding: 0;\n}\n\n#leaderboard li {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 5px 4px;\n  border-bottom: 1px solid rgba(90, 74, 74, 0.07);\n  font-size: 0.88rem;\n}\n\n#leaderboard li:last-child {\n  border-bottom: none;\n}\n\n.lb-name {\n  font-weight: 700;\n  color: #5A4A4A;\n  flex: 1;\n  margin-left: 4px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.lb-score {\n  font-weight: 700;\n  color: #7B5EA7;\n  text-align: right;\n  margin-left: 8px;\n}\n"
}
