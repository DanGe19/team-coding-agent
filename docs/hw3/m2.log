    "content": "// Side Tetris - Rendering and Keyboard Handling\n\n(function () {\n  'use strict';\n\n  const ROWS = 12;\n  const COLS = 24;\n  const CELL = 28;\n  const LEFT_MAX = 11;\n  const RIGHT_MIN = 12;\n\n  // Pastel colors per piece type\n  const COLORS = {\n    I: '#B5EAD7',\n    O: '#FFF1B5',\n    T: '#E2D5F8',\n    S: '#D4F0C0',\n    Z: '#FFD6E0',\n    J: '#C7E6FF',\n    L: '#FFDAC1',\n  };\n\n  // Slightly darker settled colors\n  const SETTLED_COLORS = {\n    I: '#7DD4B8',\n    O: '#F0D870',\n    T: '#C4A8F0',\n    S: '#A8D890',\n    Z: '#F0A0B8',\n    J: '#88C4F0',\n    L: '#F0B090',\n  };\n\n  const GRID_COLOR = '#E8D8C8';\n  const WALL_COLOR = '#C9B6F2';\n  const BG_COLOR = '#FFF8F0';\n  const GHOST_COLOR = 'rgba(180,160,220,0.25)';\n\n  let canvas, ctx;\n  let nextCanvas, nextCtx;\n\n  function init() {\n    canvas = document.getElementById('board-canvas');\n    if (!canvas) return;\n    ctx = canvas.getContext('2d');\n    canvas.width = COLS * CELL;\n    canvas.height = ROWS * CELL;\n\n    nextCanvas = document.getElementById('next-canvas');\n    if (nextCanvas) {\n      nextCtx = nextCanvas.getContext('2d');\n      nextCanvas.width = 6 * CELL;\n      nextCanvas.height = 6 * CELL;\n    }\n\n    setupKeyboard();\n    requestAnimationFrame(loop);\n  }\n\n  function loop() {\n    draw();\n    requestAnimationFrame(loop);\n  }\n\n  function draw() {\n    if (!window.__tetris) return;\n    const state = window.__tetris.getState();\n    drawBoard(state);\n    drawNext(state);\n    updateUI(state);\n  }\n\n  function drawBoard(state) {\n    if (!ctx) return;\n    const W = COLS * CELL;\n    const H = ROWS * CELL;\n\n    // Background\n    ctx.fillStyle = BG_COLOR;\n    ctx.fillRect(0, 0, W, H);\n\n    // Grid lines\n    ctx.strokeStyle = GRID_COLOR;\n    ctx.lineWidth = 0.5;\n    for (let r = 0; r <= ROWS; r++) {\n      ctx.beginPath();\n      ctx.moveTo(0, r * CELL);\n      ctx.lineTo(W, r * CELL);\n      ctx.stroke();\n    }\n    for (let c = 0; c <= COLS; c++) {\n      if (c === LEFT_MAX + 1) continue; // skip wall position\n      ctx.beginPath();\n      ctx.moveTo(c * CELL, 0);\n      ctx.lineTo(c * CELL, H);\n      ctx.stroke();\n    }\n\n    // Center wall\n    ctx.fillStyle = WALL_COLOR;\n    ctx.fillRect((LEFT_MAX + 1) * CELL - 3, 0, 6, H);\n\n    // Settled cells\n    for (let r = 0; r < ROWS; r++) {\n      for (let c = 0; c < COLS; c++) {\n        const type = state._settled ? state._settled[r][c] : null;\n        // We don't expose settled grid directly; use settledCells count only\n        // Actually we need to draw settled cells - let's use a different approach\n      }\n    }\n\n    // Draw ghost piece\n    if (state.active) {\n      const ghost = computeGhost(state.active);\n      if (ghost) {\n        ctx.fillStyle = GHOST_COLOR;\n        for (const [r, c] of ghost) {\n          ctx.fillRect(c * CELL + 1, r * CELL + 1, CELL - 2, CELL - 2);\n        }\n      }\n    }\n\n    // Active piece\n    if (state.active) {\n      ctx.fillStyle = COLORS[state.active.type] || '#CCC';\n      for (const [r, c] of state.active.cells) {\n        drawCell(ctx, r, c, COLORS[state.active.type] || '#CCC');\n      }\n    }\n\n    // Game over overlay\n    if (state.gameOver) {\n      ctx.fillStyle = 'rgba(0,0,0,0.45)';\n      ctx.fillRect(0, 0, W, H);\n    }\n  }\n\n  function drawCell(context, r, c, color) {\n    context.fillStyle = color;\n    context.beginPath();\n    if (context.roundRect) {\n      context.roundRect(c * CELL + 1, r * CELL + 1, CELL - 2, CELL - 2, 4);\n    } else {\n      context.rect(c * CELL + 1, r * CELL + 1, CELL - 2, CELL - 2);\n    }\n    context.fill();\n  }\n\n  function computeGhost(active) {\n    if (!active) return null;\n    const side = active.side;\n    const dc = side === 'left' ? 1 : -1;\n    let cells = active.cells.map(([r, c]) => [r, c]);\n    while (true) {\n      const next = cells.map(([r, c]) => [r, c + dc]);\n      if (!isValidGhost(next, side)) break;\n      cells = next;\n    }\n    // Only show ghost if it's different from active\n    const activeKey = active.cells.map(([r,c]) => `${r},${c}`).sort().join('|');\n    const ghostKey = cells.map(([r,c]) => `${r},${c}`).sort().join('|');\n    if (activeKey === ghostKey) return null;\n    return cells;\n  }\n\n  function isValidGhost(cells, side) {\n    for (const [r, c] of cells) {\n      if (r < 0 || r >= ROWS) return false;\n      if (c < 0 || c >= COLS) return false;\n      if (side === 'left' && c > LEFT_MAX) return false;\n      if (side === 'right' && c < RIGHT_MIN) return false;\n    }\n    return true;\n  }\n\n  function drawNext(state) {\n    if (!nextCtx) return;\n    const W = nextCanvas.width;\n    const H = nextCanvas.height;\n    nextCtx.fillStyle = BG_COLOR;\n    nextCtx.fillRect(0, 0, W, H);\n\n    if (!state.next) return;\n    const type = state.next;\n    const offsets = getRotState0(type);\n    const bb = bboxOffsets(offsets);\n    const pieceW = bb.maxC - bb.minC + 1;\n    const pieceH = bb.maxR - bb.minR + 1;\n    const startC = Math.floor((6 - pieceW) / 2) - bb.minC;\n    const startR = Math.floor((6 - pieceH) / 2) - bb.minR;\n\n    nextCtx.fillStyle = COLORS[type] || '#CCC';\n    for (const [dr, dc] of offsets) {\n      const r = startR + dr;\n      const c = startC + dc;\n      drawCell(nextCtx, r, c, COLORS[type] || '#CCC');\n    }\n\n    // Arrow showing which side\n    const side = state.nextSide;\n    nextCtx.fillStyle = '#9B8EC4';\n    nextCtx.font = 'bold 14px Nunito, sans-serif';\n    nextCtx.textAlign = 'center';\n    nextCtx.fillText(side === 'left' ? '\u2190 Left' : 'Right \u2192', W / 2, H - 6);\n  }\n\n  function getRotState0(type) {\n    // Access PIECES from game.js - but it's in a closure. We'll redefine minimal version.\n    const PIECES_ROT0 = {\n      I: [[0,0],[0,1],[0,2],[0,3]],\n      O: [[0,0],[0,1],[1,0],[1,1]],\n      T: [[0,1],[1,0],[1,1],[1,2]],\n      S: [[0,1],[0,2],[1,0],[1,1]],\n      Z: [[0,0],[0,1],[1,1],[1,2]],\n      J: [[0,0],[1,0],[1,1],[1,2]],\n      L: [[0,2],[1,0],[1,1],[1,2]],\n    };\n    return PIECES_ROT0[type] || [];\n  }\n\n  function bboxOffsets(offsets) {\n    let minR = Infinity, maxR = -Infinity, minC = Infinity, maxC = -Infinity;\n    for (const [r, c] of offsets) {\n      if (r < minR) minR = r;\n      if (r > maxR) maxR = r;\n      if (c < minC) minC = c;\n      if (c > maxC) maxC = c;\n    }\n    return { minR, maxR, minC, maxC };\n  }\n\n  function updateUI(state) {\n    const scoreEl = document.getElementById('score');\n    const linesEl = document.getElementById('lines');\n    const levelEl = document.getElementById('level');\n    const pausedEl = document.getElementById('paused');\n    const gameOverEl = document.getElementById('game-over');\n\n    if (scoreEl) scoreEl.textContent = state.score;\n    if (linesEl) linesEl.textContent = state.lines;\n    if (levelEl) levelEl.textContent = state.level;\n    if (pausedEl) pausedEl.style.display = state.paused ? 'flex' : 'none';\n    if (gameOverEl) gameOverEl.style.display = state.gameOver ? 'flex' : 'none';\n  }\n\n  function setupKeyboard() {\n    document.addEventListener('keydown', (e) => {\n      if (!window.__tetris) return;\n      const state = window.__tetris.getState();\n      switch (e.key) {\n        case 'ArrowUp':\n          e.preventDefault();\n          window.__tetris.shift(-1);\n          break;\n        case 'ArrowDown':\n          e.preventDefault();\n          window.__tetris.shift(1);\n          break;\n        case 'ArrowRight':\n          e.preventDefault();\n          if (state.active && state.active.side === 'left') {\n            window.__tetris.softDrop();\n          }\n          break;\n        case 'ArrowLeft':\n          e.preventDefault();\n          if (state.active && state.active.side === 'right') {\n            window.__tetris.softDrop();\n          }\n          break;\n        case 'z':\n        case 'Z':\n          window.__tetris.rotate(-1);\n          break;\n        case 'x':\n        case 'X':\n          window.__tetris.rotate(1);\n          break;\n        case ' ':\n          e.preventDefault();\n          window.__tetris.hardDrop();\n          break;\n        case 'p':\n        case 'P':\n          window.__tetris.togglePause();\n          break;\n        case 'r':\n        case 'R':\n          window.__tetris.reset();\n          break;\n      }\n    });\n  }\n\n  // Button handlers\n  document.addEventListener('DOMContentLoaded', () => {\n    const startBtn = document.getElementById('start-btn');\n    const pauseBtn = document.getElementById('pause-btn');\n    const restartBtn = document.getElementById('restart-btn');\n    const restartOverlayBtn = document.getElementById('restart-overlay-btn');\n\n    if (startBtn) startBtn.addEventListener('click', () => window.__tetris && window.__tetris.reset());\n    if (pauseBtn) pauseBtn.addEventListener('click', () => window.__tetris && window.__tetris.togglePause());\n    if (restartBtn) restartBtn.addEventListener('click', () => window.__tetris && window.__tetris.reset());\n    if (restartOverlayBtn) restartOverlayBtn.addEventListener('click', () => window.__tetris && window.__tetris.reset());\n\n    init();\n  });\n\n})();\n",
