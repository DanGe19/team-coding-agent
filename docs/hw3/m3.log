turn res.status(200).json({ message: 'All scores deleted' });\n});\n\nmodule.exports = app;\n\nif (require.main === module) {\n  app.listen(PORT, () => {\n    console.log(`Side Tetris server running on http://localhost:${PORT}`);\n  });\n}\n"}}</tool_call>
