);\n  await expect(page.locator('#leaderboard .lb-name').filter({ hasText: /^Grace$/ })).toBeVisible();\n  expect(await page.evaluate(() => window.__tetrisConformanceDocumentMarker)).toBe('same-document');\n});\n",
